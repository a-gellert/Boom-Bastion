-- main/main.script
-- Boot, camera and input routing. The battle lives in lua_modules/battle.lua.

local constants = require("lua_modules.constants")
local camera = require("lua_modules.camera_controller")
local audio = require("lua_modules.audio")
local i18n = require("lua_modules.i18n")
local battle = require("lua_modules.battle")

function init(self)
	math.randomseed(os.time())
	math.random(); math.random()

	msg.post(".", "acquire_input_focus")

	audio.init()
	i18n.detect_language()

	camera.init()
	camera.reset(constants.SCREEN_WIDTH * 0.5, constants.SCREEN_HEIGHT * 0.5)

	battle.init(self)

	audio.on_game_loaded()
	audio.music("music_battle")

	constants.log("boot ok · lang=" .. i18n.current_lang .. " · battle M2")
end

function update(self, dt)
	battle.update(self, dt)
	camera.update(dt)
end

function on_input(self, action_id, action)
	if action_id == hash("escape") and action.pressed then
		battle.toggle_pause(self)
		return true
	end
	return battle.on_input(self, action_id, action)
end

function on_message(self, message_id, message, sender)
	battle.on_message(self, message_id, message, sender)
end
