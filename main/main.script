-- main/main.script
-- Bastion Blast orchestrator. M0: boot, camera, HUD handshake, pause.
-- M2 grows the battle state machine here (AIM → FLYING → RESOLVE → ENEMY → ...).

local constants = require("lua_modules.constants")
local camera = require("lua_modules.camera_controller")
local audio = require("lua_modules.audio")
local i18n = require("lua_modules.i18n")

function init(self)
	math.randomseed(os.time())
	math.random(); math.random()

	msg.post(".", "acquire_input_focus")

	audio.init()
	i18n.detect_language()

	camera.init()
	camera.reset(constants.SCREEN_WIDTH * 0.5, constants.SCREEN_HEIGHT * 0.5)

	msg.post("/gui_hud#gui", "hud_show", { mode = "boot" })
	audio.on_game_loaded()
	audio.music("music_menu")

	constants.log("boot ok · lang=" .. i18n.current_lang .. " · mode=" .. tostring(sys.get_config_string("sdk.target", "mock")))
end

function update(self, dt)
	camera.update(dt)
end

function on_input(self, action_id, action)
	if action_id == hash("escape") and action.pressed then
		msg.post("/gui_hud#gui", "toggle_pause")
		return true
	end
	return false
end
