-- main/entities/scene/scene.script
-- M1 look-dev frame: real generated sprites, segmented castle grid, layered units,
-- gate, trajectory and a HUD-ready composition. Gameplay arrives in M2.

local art_sizes = require("lua_modules.art_sizes")

local GROUND_Y = 145
local CASTLE_BOTTOM = 200
local CELL_W = 25
local CELL_H = 21
local ROOM_W = 4
local ROOM_H = 4
local COLS = 12
local ROWS = 12

local SKY_TOP = vmath.vector4(0.56, 0.72, 0.91, 1)
local SKY_BOTTOM = vmath.vector4(1.0, 0.85, 0.66, 1)
local SUN = vmath.vector4(1.0, 0.89, 0.64, 1)
local SUN_GLOW = vmath.vector4(1.0, 0.79, 0.42, 0.55)
local CLOUD = vmath.vector4(1, 1, 1, 0.95)
local HILL_FAR = vmath.vector4(0.62, 0.73, 0.84, 1)
local HILL_NEAR = vmath.vector4(0.42, 0.66, 0.34, 1)
local GRASS = vmath.vector4(0.50, 0.75, 0.25, 1)
local GRASS_TOP = vmath.vector4(0.36, 0.60, 0.16, 1)
local WHITE = vmath.vector4(1, 1, 1, 1)
local TEAM_BLUE = vmath.vector4(0.36, 0.62, 1.0, 1)
local TEAM_RED = vmath.vector4(1.0, 0.42, 0.35, 1)

local PLAYER_X0 = 100
local ENEMY_X0 = 880
local GATE_X = 640
local GATE_Y = 400

local function parabola(x)
	return -0.0004638 * x * x + 0.40656 * x + 329.77
end

local function room_center(x0, cc, rr)
	return x0 + cc * ROOM_W * CELL_W + ROOM_W * CELL_W * 0.5,
		CASTLE_BOTTOM + rr * ROOM_H * CELL_H + ROOM_H * CELL_H * 0.5
end

local UNIT_SPOTS = {
	{ cc = 0, rr = 0 }, { cc = 2, rr = 0 }, { cc = 1, rr = 1 }, { cc = 0, rr = 2 },
}
local ENEMY_SPOTS = {
	{ cc = 2, rr = 0 }, { cc = 0, rr = 0 }, { cc = 1, rr = 1 }, { cc = 2, rr = 2 },
}

function init(self)
	self.ids = {}
	local count = 0
	local function spawn(anim, x, y, z, w, h, tint, rot)
		local id = factory.create("#placeholder_factory", vmath.vector3(x, y, z))
		local url = msg.url(nil, id, "sprite")
		sprite.play_flipbook(url, hash(anim))
		local base = art_sizes[anim] or { w, h }
		if tint then
			go.set(url, "tint", tint)
		end
		go.set_scale(vmath.vector3(w / base[1], h / base[2], 1), id)
		if rot then
			go.set_rotation(vmath.quat_rotation_z(math.rad(rot)), id)
		end
		count = count + 1
		return id
	end

	-- sky + sun + clouds
	spawn("white_pixel", 640, 360, -0.99, 1800, 950, SKY_TOP)
	spawn("bg_gradient", 640, 360, -0.98, 1800, 950, SKY_BOTTOM)
	spawn("fx_glow", 1010, 560, -0.97, 280, 280, SUN_GLOW)
	spawn("circle", 1010, 560, -0.965, 100, 100, SUN)
	spawn("fx_cloud", 280, 620, -0.96, 240, 100, CLOUD)
	spawn("fx_cloud", 810, 650, -0.96, 190, 80, CLOUD)
	spawn("fx_cloud", 1130, 515, -0.96, 150, 62, CLOUD)

	-- rolling hills + ground
	spawn("bg_hills_far", 640, 260, -0.94, 1800, 260, HILL_FAR)
	spawn("bg_hills_near", 640, 180, -0.93, 1800, 190, HILL_NEAR)
	spawn("white_pixel", 640, 45, -0.92, 1800, 200, GRASS)
	spawn("white_pixel", 640, GROUND_Y, -0.915, 1800, 14, GRASS_TOP)

	-- ground life
	for _, gx in ipairs({ 40, 430, 470, 760, 810, 1210, 1250 }) do
		spawn("grass_tuft", gx, GROUND_Y + 9, -0.905, 30, 18, WHITE)
	end
	spawn("flower", 150, GROUND_Y + 9, -0.904, 16, 18, WHITE)
	spawn("flower", 700, GROUND_Y + 9, -0.904, 16, 18, WHITE)
	spawn("flower", 1150, GROUND_Y + 9, -0.904, 16, 18, WHITE)
	spawn("bg_bird", 350, 600, -0.955, 18, 9, WHITE)
	spawn("bg_bird", 390, 588, -0.955, 14, 7, WHITE)
	spawn("bg_bird", 900, 640, -0.955, 16, 8, WHITE)

	local function build_castle(x0, team, gear_ids, spots)
		local brick = (team == "blue") and "brick_blue_" or "brick_red_"
		for r = 0, ROWS - 1 do
			for c = 0, COLS - 1 do
				local state = ((r * 13 + c * 7 + (team == "red" and 5 or 0)) % 19 == 0) and 1 or 0
				local breach = (team == "red" and c <= 1 and r >= 4 and r <= 6)
				if not breach then
					spawn(brick .. state,
						x0 + c * CELL_W + CELL_W * 0.5,
						CASTLE_BOTTOM + r * CELL_H + CELL_H * 0.5,
						-0.75 + r * 0.002 + c * 0.0001,
						CELL_W + 1, CELL_H + 1, WHITE)
				end
			end
		end

		-- dark room openings (the base centre is a door, the top centre is solid)
		for rr = 0, 2 do
			for cc = 0, 2 do
				if not (rr == 0 and cc == 1) and not (rr == 2 and cc == 1) then
					local cx, cy = room_center(x0, cc, rr)
					spawn("room_dark", cx, cy + 2, -0.72, 66, 50, WHITE)
				end
			end
		end

		-- door + structural posts
		spawn("door", x0 + 150, CASTLE_BOTTOM + 36, -0.715, 56, 72, WHITE)
		spawn("post_wood", x0 + 100, CASTLE_BOTTOM + 126, -0.714, 18, 252, WHITE)
		spawn("post_wood", x0 + 200, CASTLE_BOTTOM + 126, -0.714, 18, 252, WHITE)

		-- floor beams
		for floor = 0, 3 do
			for i = 0, 2 do
				spawn("beam_wood_0",
					x0 + i * 100 + 50,
					CASTLE_BOTTOM + floor * ROOM_H * CELL_H,
					-0.70,
					100, 16, WHITE)
			end
		end

		-- roof battlements + central tower + flag
		-- solid roof deck + side crenellations + central tower
		for c = 0, COLS - 1 do
			spawn(brick .. "0",
				x0 + c * CELL_W + CELL_W * 0.5,
				CASTLE_BOTTOM + ROWS * CELL_H + CELL_H * 0.5,
				-0.69,
				CELL_W + 1, CELL_H + 1, WHITE)
		end
		for _, c in ipairs({ 0, 2, 8, 10 }) do
			spawn(brick .. "0",
				x0 + c * CELL_W + CELL_W * 0.5,
				CASTLE_BOTTOM + (ROWS + 1) * CELL_H + CELL_H * 0.5,
				-0.69,
				CELL_W + 1, CELL_H + 1, WHITE)
		end
		for r = 0, 2 do
			for c = 4, 7 do
				spawn(brick .. "0",
					x0 + c * CELL_W + CELL_W * 0.5,
					CASTLE_BOTTOM + (ROWS + 1 + r) * CELL_H + CELL_H * 0.5,
					-0.69,
					CELL_W + 1, CELL_H + 1, WHITE)
			end
		end
		for c = 4, 7, 2 do
			spawn(brick .. "0",
				x0 + c * CELL_W + CELL_W * 0.5,
				CASTLE_BOTTOM + (ROWS + 4) * CELL_H + CELL_H * 0.5,
				-0.69,
				CELL_W + 1, CELL_H + 1, WHITE)
		end
		spawn("flag", x0 + 150, CASTLE_BOTTOM + (ROWS + 5) * CELL_H + 28, -0.68, 30, 40,
			(team == "blue") and TEAM_BLUE or TEAM_RED)

		-- the rolling cart
		spawn("wheel", x0 + 45, 166, -0.665, 58, 58, WHITE)
		spawn("wheel", x0 + 255, 166, -0.665, 58, 58, WHITE)
		spawn("castle_platform", x0 + 150, 184, -0.66, 340, 58, WHITE)

		-- units
		local body_tint = (team == "blue") and TEAM_BLUE or TEAM_RED
		for i, spot in ipairs(spots) do
			local cx = x0 + spot.cc * ROOM_W * CELL_W + ROOM_W * CELL_W * 0.5
			local cy = CASTLE_BOTTOM + spot.rr * ROOM_H * CELL_H + 44
			local z = -0.62 - i * 0.004
			spawn("fx_shadow", cx, cy - 22, z - 0.002, 50, 13, WHITE)
			spawn("unit_body", cx, cy, z, 54, 54, body_tint)
			spawn("gear_" .. gear_ids[i], cx, cy, z + 0.001, 54, 54, WHITE)
			spawn("eyes_idle", cx, cy + 2, z + 0.002, 30, 15, WHITE)
		end
	end

	build_castle(PLAYER_X0, "blue", { "bombardier", "triplet", "engineer", "sniper" }, UNIT_SPOTS)
	build_castle(ENEMY_X0, "red", { "driller", "pyro", "tank", "barrel" }, ENEMY_SPOTS)

	-- the x2 gate
	self.gate_ring = spawn("gate_x2", GATE_X, GATE_Y, -0.50, 150, 150, WHITE)
	self.gate_balloon = spawn("balloon_x2", GATE_X, GATE_Y + 105, -0.49, 72, 94, WHITE)

	-- impact on the enemy wall
	spawn("fx_burst", 905, 320, -0.55, 96, 96, WHITE)
	spawn("fx_ring", 905, 320, -0.54, 80, 80, vmath.vector4(1, 0.9, 0.7, 0.9))
	spawn("fx_smoke", 880, 300, -0.545, 50, 50, WHITE)
	spawn("fx_smoke", 928, 292, -0.545, 44, 44, WHITE)
	for _, s in ipairs({ { 870, 255 }, { 895, 245 }, { 925, 262 }, { 945, 285 } }) do
		spawn("fx_shard_red", s[1], s[2], -0.56, 14, 14, WHITE)
	end

	-- one bomb entering the gate, two leaving it
	spawn("proj_bomb", 600, parabola(600), -0.53, 26, 26, WHITE)
	spawn("fx_smoke", 575, parabola(600) + 4, -0.535, 30, 30, WHITE)
	spawn("proj_bomb", 740, parabola(740) + 12, -0.53, 24, 24, WHITE)
	spawn("proj_bomb", 740, parabola(740) - 12, -0.53, 24, 24, WHITE)
	spawn("fx_smoke", 712, parabola(712), -0.535, 28, 28, WHITE)

	-- dotted preview arc through the gate
	for i = 0, 17 do
		local x = 320 + i * 33
		local y = parabola(x)
		local a = 0.9 - i * 0.028
		spawn("fx_dot", x, y, -0.40, 11, 11, vmath.vector4(1, 1, 1, a))
	end
	spawn("fx_hand", 300, 500, -0.39, 40, 46, WHITE, -20)

	print("LOOKDEV spawned " .. tostring(count) .. " sprites")
end

function update(self, dt)
	self.t = (self.t or 0) + dt
	local bob = math.sin(self.t * 1.4) * 7
	go.set_position(vmath.vector3(GATE_X, GATE_Y + bob, -0.50), self.gate_ring)
	go.set_position(vmath.vector3(GATE_X, GATE_Y + 105 + bob, -0.49), self.gate_balloon)
end


