-- gui/hud/hud.gui_script
-- Battle HUD: turn banner, unit buttons, damage numbers, perks, meta and pause/result.

local i18n = require("lua_modules.i18n")
local audio = require("lua_modules.audio")
local camera = require("lua_modules.camera_controller")
local progress = require("lua_modules.progress")

local WHITE = vmath.vector4(1, 1, 1, 1)
local GOLD = vmath.vector4(0.98, 0.76, 0.22, 1)
local CREAM = vmath.vector4(0.98, 0.94, 0.85, 1)
local SOFT = vmath.vector4(0.90, 0.94, 1.0, 0.95)
local DIM = vmath.vector4(0.03, 0.05, 0.10, 0.66)
local DARK = vmath.vector4(0.12, 0.16, 0.24, 1)

local UNIT_SLOTS = { "bombardier", "triplet", "driller", "sniper" }
local UNIT_LABELS = { "BOMB", "TRIPLE", "DRILL", "SNIPER" }
local META_KEYS = { "fortify", "power", "vitality" }

local function box(x, y, w, h, color, image)
	local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
	gui.set_texture(node, "game")
	gui.play_flipbook(node, image or "white_pixel")
	if color then gui.set_color(node, color) end
	return node
end

local function icon(image, x, y, w, h)
	local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
	gui.set_texture(node, "game")
	gui.play_flipbook(node, image)
	return node
end

local function slice9(node, m)
	gui.set_slice9(node, vmath.vector4(m, m, m, m))
end

local function label(font, value, x, y, color, scale)
	local node = gui.new_text_node(vmath.vector3(x, y, 0), value)
	gui.set_font(node, font)
	gui.set_color(node, color or WHITE)
	gui.set_pivot(node, gui.PIVOT_CENTER)
	if scale then gui.set_scale(node, vmath.vector3(scale, scale, 1)) end
	return node
end

local function set_enabled_all(nodes, enabled)
	for _, node in ipairs(nodes) do
		gui.set_enabled(node, enabled)
	end
end

-- ------------------------------------------------------------------ init
function init(self)
	msg.post(".", "acquire_input_focus")
	i18n.detect_language()
	progress.load()
	self.paused = false
	self.result_open = false
	self.perks_open = false
	self.meta_open = false
	self.can_select = false
	self.hotseat = false
	self.side = "player"
	self.banner_seq = 0
	self.gold = progress.gold()

	-- coins / level / 2P / pause
	local pill = icon("ui_pill", 100, 686, 132, 46)
	slice9(pill, 14)
	icon("ui_coin", 52, 686, 30, 30)
	self.coins = label("body", tostring(self.gold), 108, 686, CREAM)

	self.level_label = label("body", "", 320, 686, CREAM, 0.68)

	self.p2_btn = icon("ui_pill", 1150, 686, 82, 46)
	slice9(self.p2_btn, 14)
	label("body", "2P", 1150, 686, CREAM)

	self.pause_btn = icon("ui_btn_dark", 1232, 686, 60, 60)
	slice9(self.pause_btn, 14)
	icon("ui_pause", 1232, 686, 30, 30)

	-- keep names
	self.keep_blue = label("label", i18n.t("keep_blue"), 176, 660, CREAM, 0.62)
	self.keep_red = label("label", i18n.t("keep_red"), 1104, 660, CREAM, 0.62)

	-- turn banner
	self.banner = icon("ui_pill", 640, 686, 390, 58)
	slice9(self.banner, 14)
	self.banner_text = label("label", "", 640, 686, GOLD, 0.9)
	gui.set_enabled(self.banner, false)
	gui.set_enabled(self.banner_text, false)

	self.hint = label("body", i18n.t("hint_aim"), 640, 128, SOFT)

	-- unit buttons
	self.unit_bg = {}
	self.unit_portrait = {}
	self.unit_labels = {}
	self.unit_roles = {}
	for i, unit in ipairs(UNIT_SLOTS) do
		local x = 492 + (i - 1) * 92
		local bg = icon("ui_btn_dark", x, 64, 88, 88)
		slice9(bg, 14)
		local portrait = icon("portrait_" .. unit, x, 66, 68, 68)
		local txt = label("body", UNIT_LABELS[i], x, 18, WHITE, 0.56)
		self.unit_bg[i] = bg
		self.unit_portrait[i] = portrait
		self.unit_labels[i] = txt
		self.unit_roles[i] = unit
	end

	-- damage numbers
	self.dmg_nodes = {}
	self.dmg_index = 0
	for i = 1, 10 do
		local n = label("label", "0", 0, 0, WHITE, 0.9)
		gui.set_enabled(n, false)
		self.dmg_nodes[i] = n
	end

	-- comic words
	self.words = {}
	self.word_index = 0
	for i = 1, 5 do
		local n = label("title", "", 0, 0, GOLD, 0.7)
		gui.set_enabled(n, false)
		self.words[i] = n
	end

	-- pause overlay
	local pause_dim = box(640, 360, 1280, 720, DIM)
	local pause_title = label("title", i18n.t("paused"), 640, 430, WHITE)
	local pause_hint = label("label", i18n.t("resume_hint"), 640, 355, GOLD)
	self.pause_meta_btn = icon("ui_btn_gold", 640, 270, 250, 70)
	slice9(self.pause_meta_btn, 14)
	local pause_meta_txt = label("label", i18n.t("meta_title"), 640, 270, WHITE, 0.8)
	self.pause_nodes = { pause_dim, pause_title, pause_hint, self.pause_meta_btn, pause_meta_txt }
	set_enabled_all(self.pause_nodes, false)

	-- result overlay
	local res_dim = box(640, 360, 1280, 720, DIM)
	self.result_title = label("title", "", 640, 470, GOLD)
	self.retry_btn = icon("ui_btn_gold", 640, 340, 300, 90)
	slice9(self.retry_btn, 14)
	self.result_btn_text = label("label", i18n.t("retry"), 640, 340, WHITE, 0.9)
	self.result_meta_btn = icon("ui_btn_dark", 640, 235, 240, 66)
	slice9(self.result_meta_btn, 14)
	local result_meta_txt = label("label", i18n.t("meta_title"), 640, 235, WHITE, 0.78)
	self.result_nodes = { res_dim, self.result_title, self.retry_btn, self.result_btn_text, self.result_meta_btn, result_meta_txt }
	set_enabled_all(self.result_nodes, false)
	self.result_win = false

	-- perk cards
	local perk_dim = box(640, 360, 1280, 720, DIM)
	local perk_title = label("title", i18n.t("perks_title"), 640, 615, GOLD)
	self.perk_cards = {}
	self.perk_card_bg = {}
	self.perk_card_name = {}
	self.perk_card_desc = {}
	local card_nodes = { perk_dim, perk_title }
	for i = 1, 3 do
		local x = 380 + (i - 1) * 260
		local bg = icon("ui_card", x, 340, 240, 330)
		local name = label("label", "", x, 462, WHITE, 0.5)
		gui.set_line_break(name, true)
		gui.set_size(name, vmath.vector3(210, 84, 0))
		local desc = label("body", "", x, 340, CREAM, 0.58)
		gui.set_line_break(desc, true)
		gui.set_size(desc, vmath.vector3(200, 190, 0))
		self.perk_card_bg[i] = bg
		self.perk_card_name[i] = name
		self.perk_card_desc[i] = desc
		table.insert(card_nodes, bg)
		table.insert(card_nodes, name)
		table.insert(card_nodes, desc)
	end
	self.perk_nodes = card_nodes
	set_enabled_all(self.perk_nodes, false)

	-- meta panel
	local meta_dim = box(640, 360, 1280, 720, DIM)
	local meta_panel = icon("ui_panel", 640, 360, 800, 500)
	slice9(meta_panel, 18)
	local meta_title = label("title", i18n.t("meta_title"), 640, 560, GOLD)
	self.meta_gold = label("label", i18n.t("meta_gold") .. ": " .. tostring(self.gold), 640, 505, CREAM, 0.75)
	local meta_nodes = { meta_dim, meta_panel, meta_title, self.meta_gold }
	self.meta_rows = {}
	for i, key in ipairs(META_KEYS) do
		local y = 420 - (i - 1) * 100
		local name_key = (key == "fortify") and "meta_fortify" or ((key == "power") and "meta_power" or "meta_vitality")
		local name = label("body", i18n.t(name_key), 430, y, WHITE, 0.66)
		local lvl = label("body", "", 660, y, CREAM, 0.62)
		local cost = label("body", "", 780, y, GOLD, 0.62)
		local btn = icon("ui_btn_gold", 910, y, 110, 58)
		slice9(btn, 14)
		local btn_txt = label("label", i18n.t("meta_buy"), 910, y, WHITE, 0.62)
		self.meta_rows[i] = { key = key, name = name, lvl = lvl, cost = cost, btn = btn, btn_txt = btn_txt }
		for _, n in ipairs({ name, lvl, cost, btn, btn_txt }) do table.insert(meta_nodes, n) end
	end
	self.meta_close_btn = icon("ui_btn_dark", 640, 160, 200, 62)
	slice9(self.meta_close_btn, 14)
	self.meta_close_txt = label("label", i18n.t("meta_close"), 640, 160, WHITE, 0.8)
	table.insert(meta_nodes, self.meta_close_btn)
	table.insert(meta_nodes, self.meta_close_txt)
	self.meta_nodes = meta_nodes
	set_enabled_all(self.meta_nodes, false)
end

-- ------------------------------------------------------------------ input
function update(self, dt)
	if not self.focus_acquired then
		self.focus_acquired = true
		msg.post(".", "acquire_input_focus")
	end
	if self.keep_blue then
		local bx, by = camera.world_to_screen(176, 660)
		gui.set_position(self.keep_blue, vmath.vector3(bx, by, 0))
		local rx, ry = camera.world_to_screen(1104, 660)
		gui.set_position(self.keep_red, vmath.vector3(rx, ry, 0))
	end
end

local function buy_meta(self, row)
	if progress.level(row.key) >= 10 then
		return
	end
	if progress.buy(row.key) then
		audio.play("coins")
		self.gold = progress.gold()
		gui.set_text(self.coins, tostring(self.gold))
		gui.set_text(self.meta_gold, i18n.t("meta_gold") .. ": " .. tostring(self.gold))
		gui.set_text(row.lvl, i18n.t("meta_lv", { n = progress.level(row.key) }))
		local maxed = progress.level(row.key) >= 10
		gui.set_text(row.cost, maxed and "MAX" or tostring(progress.cost(row.key)))
		gui.set_color(row.cost, maxed and SOFT or GOLD)
	end
end

local function open_meta(self)
	self.meta_open = true
	self.gold = progress.gold()
	gui.set_text(self.meta_gold, i18n.t("meta_gold") .. ": " .. tostring(self.gold))
	for _, row in ipairs(self.meta_rows) do
		local lvl = progress.level(row.key)
		gui.set_text(row.lvl, i18n.t("meta_lv", { n = lvl }))
		gui.set_text(row.cost, lvl >= 10 and "MAX" or tostring(progress.cost(row.key)))
		gui.set_color(row.cost, lvl >= 10 and SOFT or GOLD)
	end
	set_enabled_all(self.meta_nodes, true)
end

local function close_meta(self)
	self.meta_open = false
	set_enabled_all(self.meta_nodes, false)
end

local function close_perks(self)
	self.perks_open = false
	set_enabled_all(self.perk_nodes, false)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return false
	end
	if self.meta_open then
		for _, row in ipairs(self.meta_rows) do
			if gui.pick_node(row.btn, action.x, action.y) then
				buy_meta(self, row)
				return true
			end
		end
		if gui.pick_node(self.meta_close_btn, action.x, action.y) then
			audio.play_click()
			close_meta(self)
			return true
		end
		return false
	end
	if self.perks_open then
		for i, bg in ipairs(self.perk_card_bg) do
			if gui.pick_node(bg, action.x, action.y) then
				audio.play_click()
				close_perks(self)
				msg.post("/main#main", "pick_perk", { index = i })
				return true
			end
		end
		return false
	end
	if self.result_open then
		if gui.pick_node(self.retry_btn, action.x, action.y) then
			audio.play_click()
			msg.post("/main#main", "restart_battle")
			return true
		end
		if gui.pick_node(self.result_meta_btn, action.x, action.y) then
			audio.play_click()
			open_meta(self)
			return true
		end
		return false
	end
	if self.paused then
		if gui.pick_node(self.pause_meta_btn, action.x, action.y) then
			audio.play_click()
			open_meta(self)
			return true
		end
		if gui.pick_node(self.pause_btn, action.x, action.y) then
			audio.play_click()
			msg.post("/main#main", "toggle_pause")
			return true
		end
		return false
	end
	if self.can_select then
		for i, bg in ipairs(self.unit_bg) do
			if gui.pick_node(bg, action.x, action.y) then
				audio.play_click()
				msg.post("/main#main", "select_unit", { index = i })
				return true
			end
		end
	end
	if gui.pick_node(self.pause_btn, action.x, action.y) then
		audio.play_click()
		msg.post("/main#main", "toggle_pause")
		return true
	end
	if gui.pick_node(self.p2_btn, action.x, action.y) then
		audio.play_click()
		msg.post("/main#main", "toggle_hotseat")
		return true
	end
	return false
end

-- ------------------------------------------------------------------ messages
function on_message(self, message_id, message, sender)
	if message_id == hash("hud_state") then
		local units = message.units or {}
		self.can_select = (message.state == "aim")
		self.hotseat = message.hotseat and true or false
		self.side = message.side or "player"
		gui.set_color(self.p2_btn, self.hotseat and GOLD or WHITE)
		for i, row in ipairs(units) do
			local bg = self.unit_bg[i]
			if bg then
				if row.role and self.unit_roles[i] ~= row.role then
					self.unit_roles[i] = row.role
					gui.play_flipbook(self.unit_portrait[i], "portrait_" .. row.role)
				end
				if row.label then
					gui.set_text(self.unit_labels[i], row.label)
				end
				local ready = row.alive and (row.cooldown or 0) == 0
				local alpha = ready and 1 or 0.38
				gui.play_flipbook(bg, row.selected and "ui_btn_gold" or "ui_btn_dark")
				gui.set_slice9(bg, vmath.vector4(14, 14, 14, 14))
				gui.set_color(bg, vmath.vector4(1, 1, 1, alpha))
				gui.set_color(self.unit_portrait[i], vmath.vector4(1, 1, 1, alpha))
				gui.set_color(self.unit_labels[i], vmath.vector4(1, 1, 1, alpha))
				local s = row.selected and 1.06 or 1.0
				gui.set_scale(self.unit_portrait[i], vmath.vector3(s, s, 1))
			end
		end
		for i = #units + 1, 4 do
			gui.set_color(self.unit_bg[i], vmath.vector4(1, 1, 1, 0.12))
			gui.set_color(self.unit_portrait[i], vmath.vector4(1, 1, 1, 0.12))
			gui.set_color(self.unit_labels[i], vmath.vector4(1, 1, 1, 0.12))
			gui.set_text(self.unit_labels[i], "")
		end
		if message.state == "over" or message.state == "perk" then
			gui.set_text(self.hint, "")
		elseif message.state == "enemy" then
			gui.set_text(self.hint, i18n.t("hint_enemy"))
		elseif message.hotseat and message.side == "enemy" then
			gui.set_text(self.hint, i18n.t("p2_turn") .. " · " .. i18n.t("hint_aim"))
		elseif message.state == "aim" then
			gui.set_text(self.hint, i18n.t("hint_aim"))
		else
			gui.set_text(self.hint, "")
		end
		if message.level_id then
			gui.set_text(self.level_label, "LEVEL " .. tostring(message.level_id) .. " · " .. tostring(message.level_name or ""))
		end

	elseif message_id == hash("show_banner") then
		self.banner_seq = self.banner_seq + 1
		local seq = self.banner_seq
		gui.set_text(self.banner_text, message.text or "")
		gui.set_enabled(self.banner, true)
		gui.set_enabled(self.banner_text, true)
		gui.set_scale(self.banner, vmath.vector3(0.82, 0.82, 1))
		gui.set_scale(self.banner_text, vmath.vector3(0.8, 0.8, 1))
		gui.animate(self.banner, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.24)
		gui.animate(self.banner_text, "scale", vmath.vector3(0.9, 0.9, 1), gui.EASING_OUTBACK, 0.24)
		timer.delay(1.35, false, function()
			if self.banner_seq == seq then
				gui.set_enabled(self.banner, false)
				gui.set_enabled(self.banner_text, false)
			end
		end)

	elseif message_id == hash("show_damage") then
		local sx, sy = camera.world_to_screen(message.x or 640, message.y or 360)
		self.dmg_index = (self.dmg_index % #self.dmg_nodes) + 1
		local n = self.dmg_nodes[self.dmg_index]
		pcall(gui.cancel_animation, n, "position")
		pcall(gui.cancel_animation, n, "color")
		gui.set_text(n, tostring(math.floor(message.amount or 0)))
		gui.set_position(n, vmath.vector3(sx, sy, 0))
		gui.set_color(n, vmath.vector4(1, 1, 1, 1))
		gui.set_scale(n, vmath.vector3(0.95, 0.95, 1))
		gui.set_enabled(n, true)
		gui.animate(n, "position", vmath.vector3(sx, sy + 48, 0), gui.EASING_OUTQUAD, 0.75)
		gui.animate(n, "color", vmath.vector4(1, 0.9, 0.8, 0), gui.EASING_OUTQUAD, 0.75, 0, function(_, node)
			gui.set_enabled(node, false)
		end, gui.PLAYBACK_ONCE_FORWARD)

	elseif message_id == hash("show_word") then
		local sx, sy = camera.world_to_screen(message.x or 640, message.y or 360)
		self.word_index = (self.word_index % #self.words) + 1
		local n = self.words[self.word_index]
		pcall(gui.cancel_animation, n, "position")
		pcall(gui.cancel_animation, n, "color")
		pcall(gui.cancel_animation, n, "scale")
		gui.set_text(n, message.word or "BOOM!")
		gui.set_position(n, vmath.vector3(sx, sy, 0))
		gui.set_rotation(n, vmath.quat_rotation_z(math.rad(-10 + math.random() * 20)))
		gui.set_scale(n, vmath.vector3(0.55, 0.55, 1))
		gui.set_color(n, vmath.vector4(1, 0.92, 0.35, 1))
		gui.set_enabled(n, true)
		gui.animate(n, "scale", vmath.vector3(1.05, 1.05, 1), gui.EASING_OUTBACK, 0.22)
		gui.animate(n, "position", vmath.vector3(sx, sy + 56, 0), gui.EASING_OUTQUAD, 0.75)
		gui.animate(n, "color", vmath.vector4(1, 0.75, 0.2, 0), gui.EASING_OUTQUAD, 0.75, 0, function(_, node)
			gui.set_enabled(node, false)
		end, gui.PLAYBACK_ONCE_FORWARD)

	elseif message_id == hash("show_perks") then
		local offers = message.offers or {}
		for i = 1, 3 do
			local o = offers[i]
			gui.set_text(self.perk_card_name[i], o and o.name or "")
			gui.set_text(self.perk_card_desc[i], o and o.desc or "")
		end
		self.perks_open = true
		set_enabled_all(self.perk_nodes, true)

	elseif message_id == hash("hud_gold") then
		self.gold = message.gold or progress.gold()
		gui.set_text(self.coins, tostring(self.gold))

	elseif message_id == hash("battle_over") then
		self.result_open = true
		self.result_win = message.win and true or false
		local title = i18n.t("defeat")
		if message.complete then
			title = i18n.t("campaign_complete")
		elseif message.hotseat then
			title = (message.winner == "player") and i18n.t("p1_wins") or i18n.t("p2_wins")
		elseif message.win then
			title = i18n.t("victory")
		end
		gui.set_text(self.result_title, title)
		gui.set_color(self.result_title, (message.win or message.complete) and GOLD or vmath.vector4(1, 0.45, 0.4, 1))
		gui.set_text(self.result_btn_text, i18n.t("retry"))
		set_enabled_all(self.result_nodes, true)

	elseif message_id == hash("battle_restart") then
		self.result_open = false
		close_perks(self)
		set_enabled_all(self.result_nodes, false)

	elseif message_id == hash("pause_changed") then
		self.paused = message.paused and true or false
		set_enabled_all(self.pause_nodes, self.paused)
		if self.paused then
			audio.pause_all()
		else
			audio.resume_all()
		end
	end
end
