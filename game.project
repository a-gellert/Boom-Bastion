[bootstrap]
main_collection = /main/main.collectionc
render = /main/game.renderc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1

[project]
title = Bastion Blast
version = 0.1.0

[graphics]
opengl_version_hint = 42

[sprite]
max_count = 2048

[collection]
max_instances = 2048

[sound]
max_sound_data = 32
max_sound_instances = 64
max_sound_sources = 32
max_component_count = 48

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0

[sdk]
target = mock
